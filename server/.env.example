# ---------------------------------------------------------------------------
# CREATIVE ENGINE — SERVER ENVIRONMENT
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=creative_engine
DB_POOL=10

# --- Security -------------------------------------------------------------
# Generate a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string-before-going-live
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_DAYS=30

# --- Uploads --------------------------------------------------------------
MAX_FILE_SIZE_MB=50

# --- Finance --------------------------------------------------------------
VAT_RATE=18
FX_REFRESH_HOURS=12

# --- AI (optional; the assistant stays off until this is set) -------------
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_API_URL=https://api.anthropic.com/v1/messages
